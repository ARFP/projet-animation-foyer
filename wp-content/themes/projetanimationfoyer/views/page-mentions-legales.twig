{% extends 'base.twig' %}

{% block content %}
<article class="post-type-{{ post.type }}" id="post-{{ post.id }}">
    <section class="article-content">
         
        <div class="article-body">{{ post.content }}</div>
    </section>
</article>

<div class="bottom-wrapper">
      {% include 'parts/bottom-wrapper.twig' %}
</div>
{% endblock %}
